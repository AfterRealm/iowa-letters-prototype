    "iowa-mustering": {
      "label": "Iowa mustering and training",
      "description": "Cities in Iowa where regiments were raised, trained, and embarked. Camp McClellan at Davenport was the principal training depot."
    },
    "iowa-home": {
      "label": "Iowa home counties",
      "description": "County centroids in Iowa. Used in this prototype to anchor the home end of the soldier-correspondent line for each letter."
    },
    "western": {
      "label": "Western Theater",
      "description": "The campaigns in Kentucky, Tennessee, Mississippi, and Alabama, including the Vicksburg campaign of 1862-1863."
    },
    "atlanta-campaign": {
      "label": "Atlanta Campaign",
      "description": "Sherman's drive from northwest Georgia to Atlanta, May to September 1864."
    },
    "march-to-the-sea": {
      "label": "March to the Sea",
      "description": "Sherman's march from Atlanta to Savannah, November to December 1864."
    },
    "carolinas-campaign": {
      "label": "Carolinas Campaign",
      "description": "Sherman's march north through South and North Carolina, January to April 1865."
    },
    "eastern": {
      "label": "Eastern Theater",
      "description": "Virginia and the Maryland frontier; included here for completeness and for letters that may reference distant events."
